{
  "manifest_version": 3,
  "name": "Google Slides Quick Draw",
  "version": "1.0.0",
  "description": "Google Slides でペンをアンロック",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/presentation/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Google Slides Quick Draw — OFF"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "content_script.js"
      ],
      "css": [
        "content_style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "app.js",
        "icons.js",
        "config.js"
      ],
      "matches": [
        "https://docs.google.com/*"
      ]
    }
  ]
}
